<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartCart"
             x:Class="SmartCart.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#4CAF50</Color>
            <Color x:Key="AccentColor">#ADEBB3</Color>
            <Color x:Key="WarningColor"></Color>
            <Color x:Key="DangerColor">#FF0800</Color>
            <Color x:Key="SuccessColor">#02590F</Color>
            <Color x:Key="BackgroundWhite">#FEFEFA</Color>
            <Color x:Key="BorderColor">#191970</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundWhite}"/>
            </Style>

            <Style TargetType="Label" x:Key="PageTitle">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#1A1A1A"/>
            </Style>

            <Style TargetType="Label" x:Key="SectionTitle">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="12"/>
                </Setter>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0, 6"/>
                <Setter Property="BackgroundColor" Value="#FEFEFA"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="TextColor" Value="#1A1A1A"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Button" x:Key="SecondaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}"/>
                <Setter Property="TextColor" Value="#1A1A1A"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="50"/>
            </Style>
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="#FEFEFA"/>
                <Setter Property="HeightRequest" Value="45"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
