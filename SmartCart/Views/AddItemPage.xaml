<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.AddItemPage"
             Title="Add Items"
             BackgroundColor="#F7F9FC">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="18">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Add Items"
                   Style="{StaticResource PageTitle}"/>

            <Label Text="Browse and add items to your list"
                   FontSize="14"
                   FontAttributes="Italic"
                   TextColor="#777"/>
        </VerticalStackLayout>

        <!-- SEARCH -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="14">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                <Image Source="search.png"
                       HeightRequest="20"
                       Opacity="0.6"/>

                <Entry Grid.Column="1"
                       Placeholder="Search groceries..."
                       BackgroundColor="Transparent"
                       TextChanged="OnSearchTextChanged"/>
            </Grid>
        </Border>

        <!-- DEPARTMENTS -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <Label Text="Shop by Department"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <CollectionView ItemsSource="{Binding Departments}"
                            SelectionMode="Single"
                            SelectionChanged="OnDepartmentSelected"
                            HeightRequest="125">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="6"
                               Margin="5"
                               CornerRadius="16"
                               HasShadow="False"
                               BackgroundColor="White"
                               BorderColor="{StaticResource PrimaryColor}">

                            <VerticalStackLayout Spacing="2"
                                                 HorizontalOptions="Center">
            <Picker x:Name="CategoryPicker"
                    Title="Category">
                <Picker.Items>
                    <x:String>Dairy</x:String>
                    <x:String>Produce</x:String>
                    <x:String>Bakery</x:String>
                    <x:String>Meat</x:String>
                    <x:String>Frozen</x:String>
                    <x:String>Pantry</x:String>
                    <x:String>Beverages</x:String>
                </Picker.Items>
            </Picker>

                                <Label Text="🛒"
                                       FontSize="16"/>

                                <Label Text="{Binding}"
                                       FontAttributes="Bold"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>

        <!-- ITEMS + TOTAL -->
        <Grid Grid.Row="3"
              RowDefinitions="Auto,*"
              RowSpacing="10">

           
            <!-- TOTAL -->
            <!-- <Border Style="{StaticResource CardStyle}"
                    Padding="14"
                    BackgroundColor="{StaticResource PrimaryColor}">

                <Grid ColumnDefinitions="*,Auto">

                    <Label Text="Running Total"
                           TextColor="White"
                           FontAttributes="Bold"/>

                    <Label Grid.Column="1"
                           Text="{Binding Total, StringFormat='{}{0:C}'}"
                           TextColor="White"
                           FontAttributes="Bold"/>
                </Grid>
            </Border> -->

            <!-- ITEMS -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="16"
                                Margin="0,0,0,12">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <!-- NAME -->
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="17"/>

                                <!-- ADD BUTTON -->
                                <Button Grid.Column="1"
                                        Text="+"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        CornerRadius="19"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        TextColor="White"
                                        Clicked="OnQuickAddItem"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>