<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.AddItemPage"
             Title="AddItemPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Add Grocery Item"
             Style="{StaticResource PageTitle}"/>

            <Entry Placeholder="Item Name"/>

            <Entry Placeholder="Description"/>

            <Entry Placeholder="Price"
               Keyboard="Numeric"/>

            <Picker Title="Category"/>

            <Button Text="+ Add Item To Cart"
                Style="{StaticResource PrimaryButton}"/>

            <Button Text="X Delete Item From Cart"
                BackgroundColor="{StaticResource DangerColor}"
                TextColor="#FEFEFA"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>