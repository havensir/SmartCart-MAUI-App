<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.BudgetPage"
             Title="BudgetPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Create Budget"
                   Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout>
                    <Label Text="Monthly Budget"
                           FontAttributes="Bold"/>

                    <Label Text="Current Budget"
                           Style="{StaticResource SectionTitle}"/>

                    <!-- Bind to ViewModel properties -->
                    <Label Text="{Binding BudgetSummaryText}"/>

                    <ProgressBar Progress="{Binding BudgetProgress}"/>

                    <Label Text="{Binding RemainingBudgetText}"
                           TextColor="{StaticResource SuccessColor}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Bind Input Controls -->
            <Entry Placeholder="Budget Name" 
                   Text="{Binding BudgetName}" />

            <Entry Placeholder="Budget Amount"
               Keyboard="Numeric"
               Text="{Binding BudgetAmount}" /> 

            <Label Text="Budget Period"/>
            <VerticalStackLayout>
                <!-- GroupName ensures they act as a single choice group -->
                <RadioButton Content="Weekly" GroupName="BudgetPeriod" IsChecked="{Binding IsWeekly}"/>
                <RadioButton Content="Bi-Weekly" GroupName="BudgetPeriod" IsChecked="{Binding IsBiWeekly}"/>
                <RadioButton Content="Monthly" GroupName="BudgetPeriod" IsChecked="{Binding IsMonthly}"/>
            </VerticalStackLayout>

            <Editor Placeholder="Notes (Optional)"
                    Text="{Binding BudgetNotes}"
                    HeightRequest="100"/>

            <Button Text="Save"
                    Command="{Binding SaveBudgetCommand}"
                    Style="{StaticResource PrimaryButton}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>