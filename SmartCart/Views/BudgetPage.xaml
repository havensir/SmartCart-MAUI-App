<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.BudgetPage"
             Title="BudgetPage"
             BackgroundColor="#F7F9FC">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- DISPLAY SECTION -->
            <Label Text="Your Budget"
       Style="{StaticResource PageTitle}"/>

            <!-- CREATE SECTION -->
            <Label Text="Create or Update Budget"
           Style="{StaticResource SectionTitle}"/>
            <Border 
    BackgroundColor="White"
    Stroke="#DCE3EB"
    StrokeShape="RoundRectangle 22"
    Padding="22">

                <VerticalStackLayout Spacing="12">

                    <Entry Placeholder="Budget Name" 
               Text="{Binding BudgetName}" />

                    <Entry Placeholder="Budget Amount"
               Keyboard="Numeric"
               Text="{Binding BudgetAmount}" />

                    <Label Text="Budget Period"/>

                    <HorizontalStackLayout Spacing="20">
                        <RadioButton Content="Weekly" IsChecked="{Binding IsWeekly}"/>
                        <RadioButton Content="Bi-Weekly" IsChecked="{Binding IsBiWeekly}"/>
                        <RadioButton Content="Monthly" IsChecked="{Binding IsMonthly}"/>
                    </HorizontalStackLayout>

                    <Editor Placeholder="Notes (Optional)"
                Text="{Binding BudgetNotes}"
                HeightRequest="80"/>

                    <Button Text="Save"
                Command="{Binding SaveBudgetCommand}"
                Style="{StaticResource PrimaryButton}"/>

                    <Button Text="Clear All"
                Command="{Binding DeleteAllBudgetInfoCommand}"
                BackgroundColor="{StaticResource DangerColor}"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>