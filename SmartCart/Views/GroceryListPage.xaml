<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.GroceryListPage"
             Title="GroceryListPage">
    <VerticalStackLayout Padding="16" Spacing="20">

        <Label Text="My Grocery List"
           Style="{StaticResource PageTitle}" />

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="10">

                <Image Source="search.png"
                   HeightRequest="22"
                   WidthRequest="22"/>

                <Entry Grid.Column="1"
                   Placeholder="Search for groceries"
                   BackgroundColor="Transparent"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="*,Auto">

                <Label Text="Your Current Total Is:"
                   FontAttributes="Bold"/>

                <Label Grid.Column="1"
                   Text="{Binding Total, StringFormat='${0:F2}'}"
                   FontAttributes="Bold"/>
            </Grid>
        </Border>

        <CollectionView ItemsSource="{Binding Items}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource CardStyle}">

                        <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto">

                            <Label Text="{Binding Name}"
                       FontAttributes="Bold"
                       FontSize="18"/>

                            <Button Text="Edit"
                        Grid.Column="1"
                        HeightRequest="36"
                        WidthRequest="65"
                        Style="{StaticResource SecondaryButton}"/>

                            <Label Grid.Row="1"
                       Text="{Binding Price, StringFormat='${0:F2}'}"
                       FontSize="16"
                       VerticalOptions="Center"/>

                            <HorizontalStackLayout Grid.Row="1"
                                       Grid.Column="1"
                                       Spacing="10"
                                       VerticalOptions="Center">

                                <Button Text="-"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnLowerQuantityNumber"/>

                                <Label Text="{Binding Quantity}"
                           FontSize="18"
                           VerticalOptions="Center"/>

                                <Button Text="+"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Clicked="OnRaiseQuantityNumber"/>

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>


        <Button Text="+ Add Item"
            Style="{StaticResource PrimaryButton}" />



    </VerticalStackLayout>
</ContentPage>