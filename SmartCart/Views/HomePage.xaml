<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.HomePage"
             Title="SmartCart"
             BackgroundColor="#F7F9FC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,10">

                <VerticalStackLayout Padding="5" Spacing="10">

                    <!-- HEADER -->
                    <Grid ColumnDefinitions="*,Auto,Auto"
              Padding="0,12,0,20">

                        <!-- Title -->
                        <Label Grid.Column="0"
                   Text="{Binding WelcomeText}"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1E293B"
                   VerticalOptions="Center"/>

                        <!-- Profile -->
                        <Border Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#DCE3EB"
                    StrokeShape="RoundRectangle 18"
                    Padding="12"
                    Margin="8,0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileTapped"/>
                            </Border.GestureRecognizers>

                            <Image Source="profile.png"
                       HeightRequest="24"
                       WidthRequest="24"/>
                        </Border>

                        <!-- Share -->
                        <Border Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#DCE3EB"
                    StrokeShape="RoundRectangle 18"
                    Padding="12"
                    Margin="8,0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareTapped"/>
                            </Border.GestureRecognizers>

                            <Image Source="share.png"
                       HeightRequest="24"
                       WidthRequest="24"/>
                        </Border>

                    </Grid>

                    <!-- BUDGET CARD -->
                    <Border BackgroundColor="White"
                Stroke="#DCE3EB"
                StrokeShape="RoundRectangle 22"
                Padding="22">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="Budget Overview"
                       FontSize="28"
                       FontAttributes="Bold"/>

                            <!-- HAS BUDGET -->
                            <VerticalStackLayout IsVisible="{Binding HasBudget}" Spacing="12">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Current Budget"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                Text="Edit"
                                FontSize="12"
                                HeightRequest="34"
                                WidthRequest="72"
                                CornerRadius="16"
                                BackgroundColor="#E8F0FE"
                                TextColor="#1D4ED8"

                                Clicked="OnCreateBudgetClicked" />
                                </Grid>

                                <Label Text="{Binding BudgetTitle}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#111827" />

                                <Label Text="{Binding BudgetAmount, StringFormat='{}{0:C}'}"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#16A34A" />

                                <Label Text="{Binding BudgetSummaryText}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="#6B7280" />

                                <Label Text="{Binding RemainingBudgetText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#1D4ED8" />

                                <ProgressBar Progress="{Binding BudgetProgress}"
                                 HeightRequest="10"
                                 ProgressColor="#16A34A"
                                 BackgroundColor="#E5E7EB" />

                            </VerticalStackLayout>

                            <!-- NO BUDGET -->
                            <HorizontalStackLayout IsVisible="{Binding NeedsBudget}" Spacing="12">

                                <Label Text="You haven't set up a budget yet."
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="Gray"/>

                                <Button Text="Create Budget"
                            Clicked="OnCreateBudgetClicked"
                Style="{StaticResource PrimaryButton}"
                                        HeightRequest="35"
                                        FontSize="12"
                            TextColor="White"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <!-- STORES -->
                    <Label Text="Local Grocery Stores"
               FontSize="26"
                           Padding="0,20,0,0"
               FontAttributes="Bold"/>

                    <CollectionView ItemsSource="{Binding Stores}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Grid Padding="5" ColumnDefinitions="110, *">

                                    <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center"
                                     Spacing="5">

                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                            Tapped="OnStoreTapped"
                            CommandParameter="{Binding Name}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- IMAGE -->
                                        <Border WidthRequest="100"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 35"
                            Style="{StaticResource CardStyle}">
                                            <Image Source="{Binding Image}" Aspect="AspectFit"/>
                                        </Border>

                                        <!-- NAME -->
                                        <Label Text="{Binding Name}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                     Padding="10"
                                     Spacing="5"
                                     VerticalOptions="Center">

                                        <Label Text="{Binding ProduceDisplay, StringFormat='Produce: {0}'}" />
                                        <Label Text="{Binding MeatDisplay, StringFormat='Meat: {0}'}" />
                                        <Label Text="{Binding DairyDisplay, StringFormat='Dairy: {0}'}" />

                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                    <!-- GRID OF STORES -->
                    <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="16"
              RowSpacing="16">

                        <!-- Kroger -->
                        <Border Grid.Row="0" Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#DCE3EB">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Kroger"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="kroger.png" HeightRequest="56"/>
                                <Label Text="Kroger" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Walmart -->
                        <Border Grid.Row="0" Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#DCE3EB">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Walmart"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="walmart.png" HeightRequest="56"/>
                                <Label Text="Walmart" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Target -->
                        <Border Grid.Row="1" Grid.Column="0" Padding="16" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#DCE3EB">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Target"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="target.png" HeightRequest="56"/>
                                <Label Text="Target" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Aldi -->
                        <Border Grid.Row="1" Grid.Column="1" Padding="16" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#DCE3EB">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Aldi"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="aldi.png" HeightRequest="56"/>
                                <Label Text="Aldi" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ACTION BUTTON -->
                    <Button Text="View Grocery Lists"
                HeightRequest="52"
                FontSize="18"
                CornerRadius="18"
                Margin="0,20,0,0"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnViewGroceryListsClicked" />

                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
     