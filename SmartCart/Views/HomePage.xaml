<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.HomePage"
             Title="HomePage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="0,10">

                <!-- Title -->
                <Label Text="{Binding WelcomeText}" 
                   Grid.Column="0"
                   FontSize="24"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"/>

                <!-- Sign In -->
                <VerticalStackLayout Grid.Column="1"
                         HorizontalOptions="Center"
                         Spacing="2">
                    
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    
                <Image Source="profile.png"
                       HeightRequest="26"
                       WidthRequest="26"/>
                    
                    <Label Text="Sign In"
                           FontSize="10"
                           HorizontalTextAlignment="Center"/>


                </VerticalStackLayout>

                <!-- My Cart -->
                <VerticalStackLayout Grid.Column="2"
                         HorizontalOptions="Center"
                         Spacing="2">
                    
                 
                    
                    <Image Source="cart.png"
               HeightRequest="26"
               WidthRequest="26"/>
                    <Label Text="My Cart"
               FontSize="10"
               HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Share -->
                <VerticalStackLayout Grid.Column="3"
                         HorizontalOptions="Center"
                         Spacing="2">
                    <Image Source="share.png"
               HeightRequest="26"
               WidthRequest="26"/>
                    <Label Text="Share"
               FontSize="10"
               HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Budget Overview"
               Style="{StaticResource PageTitle}" />

                    <!-- View shown when user has created a budget -->
                    <VerticalStackLayout IsVisible="{Binding HasBudget}" Spacing="5">

                        <Label Text="Current Budget:"
                   FontSize="16"
                   TextColor="Gray" />

                        <Label Text="{Binding BudgetAmount, StringFormat='{}{0:C}'}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="ForestGreen" />

                        <!-- Amount Spent -->
                        <Label Text="{Binding BudgetSummaryText}"
                   FontSize="14"
                   TextColor="Gray" />

                        <!-- Remaining Budget -->
                        <Label Text="{Binding RemainingBudgetText}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="DarkBlue" />

                        <!-- Progress Bar -->
                        <ProgressBar Progress="{Binding BudgetProgress}"
                         HeightRequest="8"
                         BackgroundColor="#E0E0E0" />
                    </VerticalStackLayout>

                    <!-- View shown when user has NOT created a budget -->
                    <HorizontalStackLayout IsVisible="{Binding NeedsBudget}" Spacing="10">
                        <Label Text="You haven't set up a budget yet."
                   FontSize="16"
                   FontAttributes="Italic"
                   TextColor="Gray"
                   VerticalOptions="Center" />

                        <Button Text="Create a Budget"
                        Clicked="OnCreateBudgetClicked"
                        BackgroundColor="#4CAF50"      
                        TextColor="Black"
                        FontAttributes="Bold"
                        HeightRequest="30"
                        FontSize="12"
                        Padding="10,0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="Well-Known Local Stores"
                 Style="{StaticResource SectionTitle}"/>

            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="18">
                    <VerticalStackLayout>
                        
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Kroger"/>
                        </VerticalStackLayout.GestureRecognizers>
                        
                        <Border WidthRequest="100"
                              HeightRequest="100"
                              StrokeShape="RoundRectangle 35"
                              Style="{StaticResource CardStyle}">
                            <Image Source="kroger.png"/>
                        </Border>
                        <Label Text="Kroger"
                             FontSize="12"
                             HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    
                    <VerticalStackLayout>
                        
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Walmart"/>
                        </VerticalStackLayout.GestureRecognizers>
                        
                        <Border WidthRequest="100"
                              HeightRequest="100"
                              StrokeShape="RoundRectangle 35"
                              Style="{StaticResource CardStyle}">
                            <Image Source="walmart.png"/>
                        </Border>
                        <Label Text="Walmart"
                             FontSize="12"
                             HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout>
                        
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Target"/>
                        </VerticalStackLayout.GestureRecognizers>
                        
                        <Border WidthRequest="100"
                              HeightRequest="100"
                              StrokeShape="RoundRectangle 35"
                              Style="{StaticResource CardStyle}">
                            <Image Source="target.png"/>
                        </Border>
                        <Label Text="Target"
                             FontSize="12"
                             HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStoreTapped" CommandParameter="Aldi"/>
                        </VerticalStackLayout.GestureRecognizers>
                        
                        <Border WidthRequest="100"
                              HeightRequest="100"
                              StrokeShape="RoundRectangle 35"
                              Style="{StaticResource CardStyle}">
                            <Image Source="aldi.png"/>
                        </Border>
                        <Label Text="Aldi"
                             FontSize="12"
                             HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>
            </ScrollView>
            
            <Button Text="View Grocery Lists"
                  Style="{StaticResource PrimaryButton}"/>
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>