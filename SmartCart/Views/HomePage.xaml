<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartCart.Views.HomePage"
             Title="SmartCart"
             BackgroundColor="#F7F9FC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Padding="0,12,0,20">

                <!-- Title -->
                <Label Grid.Column="0"
                       Text="{Binding WelcomeText}"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#1E293B"
                       VerticalOptions="Center"/>

                <!-- Profile -->
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#DCE3EB"
                        StrokeShape="RoundRectangle 18"
                        Padding="12"
                        Margin="8,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </Border.GestureRecognizers>

                    <Image Source="profile.png"
                           HeightRequest="24"
                           WidthRequest="24"/>
                </Border>

                <!-- Cart -->
                <Border Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#DCE3EB"
                        StrokeShape="RoundRectangle 18"
                        Padding="12"
                        Margin="8,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartTapped"/>
                    </Border.GestureRecognizers>

                    <Image Source="cart.png"
                           HeightRequest="24"
                           WidthRequest="24"/>
                </Border>

                <!-- Share -->
                <Border Grid.Column="3"
                        BackgroundColor="White"
                        Stroke="#DCE3EB"
                        StrokeShape="RoundRectangle 18"
                        Padding="12"
                        Margin="8,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShareTapped"/>
                    </Border.GestureRecognizers>

                    <Image Source="share.png"
                           HeightRequest="24"
                           WidthRequest="24"/>
                </Border>

            </Grid>


            <!-- BUDGET CARD -->
            <Border BackgroundColor="White"
                    Stroke="#DCE3EB"
                    StrokeShape="RoundRectangle 22"
                    Padding="22">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Budget Overview"
                               FontSize="28"
                               FontAttributes="Bold"/>

                        <Button Grid.Column="1"
                                Text="Edit"
                                FontSize="12"
                                HeightRequest="34"
                                WidthRequest="72"
                                Clicked="OnCreateBudgetClicked"/>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding HasBudget}"
                                         Spacing="8">

                        <Label Text="Current Budget"
                               FontSize="15"
                               TextColor="Gray"/>

                        <Label Text="{Binding BudgetAmount, StringFormat='{}{0:C}'}"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#16A34A"/>

                        <Label Text="{Binding BudgetSummaryText}"
                               FontSize="14"
                               TextColor="Gray"/>

                        <Label Text="{Binding RemainingBudgetText}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1D4ED8"/>

                        <ProgressBar Progress="{Binding BudgetProgress}"
                                     HeightRequest="10"/>
                    </VerticalStackLayout>

                    <HorizontalStackLayout IsVisible="{Binding NeedsBudget}"
                                           Spacing="12">

                        <Label Text="You haven't set up a budget yet."
                               VerticalOptions="Center"
                               FontSize="15"
                               TextColor="Gray"/>

                        <Button Text="Create Budget"
                                Clicked="OnCreateBudgetClicked"
                                BackgroundColor="#2E7D32"
                                TextColor="White"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- STORES -->
            <Label Text="Well-Known Local Stores"
                   FontSize="26"
                   FontAttributes="Bold"/>

          
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="16">

                <!-- Kroger -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="16"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnStoreTapped"
                                CommandParameter="Kroger"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Image Source="kroger.png"
                               HeightRequest="56"/>

                        <Label Text="Kroger"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>


                <!-- Walmart -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnStoreTapped"
                                CommandParameter="Walmart"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Image Source="walmart.png"
                               HeightRequest="56"/>

                        <Label Text="Walmart"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>


                <!-- Target -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="16"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnStoreTapped"
                                CommandParameter="Target"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Image Source="target.png"
                               HeightRequest="56"/>

                        <Label Text="Target"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>


                <!-- Aldi -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Padding="16"
                        StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout HorizontalOptions="Center">

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnStoreTapped"
                                CommandParameter="Aldi"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Image Source="aldi.png"
                               HeightRequest="56"/>

                        <Label Text="Aldi"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>

            </Grid>


            <!-- PRIMARY ACTION -->
            <Button Text="View Grocery Lists"
                    HeightRequest="52"
                    FontSize="18"
                    CornerRadius="18"
                    Style="{StaticResource PrimaryButton}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>